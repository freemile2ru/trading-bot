# --- Anthropic ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Exchange (read-only for market data, no keys needed for public Binance) ---
BINANCE_API_KEY=
BINANCE_SECRET=

# --- Market Data ---
COINGECKO_API_KEY=          # optional — free tier works without key
COINMARKETCAP_API_KEY=      # https://pro.coinmarketcap.com/

# --- News & Sentiment ---
CRYPTOPANIC_API_KEY=        # https://cryptopanic.com/developers/api/
NEWS_API_KEY=               # https://newsapi.org/

# --- Social ---
TWITTER_BEARER_TOKEN=       # https://developer.twitter.com/

# --- On-chain ---
ETHERSCAN_API_KEY=          # https://etherscan.io/apis
BSCSCAN_API_KEY=            # https://bscscan.com/apis

# --- Macro (all free) ---
FRED_API_KEY=               # https://fred.stlouisfed.org/docs/api/api_key.html

# --- App config ---
REDIS_URL=redis://localhost:6379
PORT=8000
CACHE_TTL_SECONDS=60
LOG_LEVEL=INFO
