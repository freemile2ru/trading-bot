# Copy to backend/.env and fill in. Every setting except ANTHROPIC_API_KEY is optional;
# anything left out uses the default shown here. Money amounts are USD, "%" settings are
# percentages (1.0 = 1%), and fee/slippage rates are fractions (0.0005 = 0.05%).
#
# Put a comment on its own line above an EMPTY key: python-dotenv reads `KEY=   # note`
# as the value "# note". (A comment after a real value, `KEY=5   # note`, is fine.)

# ── API keys ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here   # required — Claude writes the trade analyses (console.anthropic.com)
# the scanner's coin list (top coins by market cap); free tier is enough — pro.coinmarketcap.com
COINMARKETCAP_API_KEY=
# optional — coin details and global market stats; works without a key, a free demo key raises the rate limit
COINGECKO_API_KEY=
# optional — crypto news headlines for sentiment — cryptopanic.com/developers/api
CRYPTOPANIC_API_KEY=
# News is scraped from public RSS/Atom feeds, Google News and Binance announcements (backend/news/)
# and classified by Claude — no key needed. NewsAPI was dropped; NEWS_API_KEY is no longer read.
NEWS_ENABLED=true
NEWS_CLAUDE_DAILY_CALLS=75     # Claude calls a day to classify headlines (up to 25 per call; halved 2026-10-08)
NEWS_CLASSIFY_MAX_WAIT=1800    # seconds a partial batch waits before it's classified anyway (Binance listings: never)
NEWS_HALF_LIFE_H=6             # how fast a headline's weight fades
NEWS_ALERT_IMPORTANCE=4        # alert when news at least this important hits a coin you hold
NEWS_BRIEF_DAILY_CALLS=30      # Claude calls a day for the App headlines edition (halved 2026-10-08)
NEWS_BRIEF_EVERY=3600          # seconds between editions when the picture has changed
# optional — X/Twitter posts for social sentiment — developer.twitter.com
TWITTER_BEARER_TOKEN=
# optional — US macro data: interest rates, VIX, yield curve (free) — fred.stlouisfed.org
FRED_API_KEY=

# ── SMS alerts (optional, via Twilio) — texted when a strong signal fires ──────
# Twilio account ID
TWILIO_ACCOUNT_SID=
# Twilio auth token
TWILIO_AUTH_TOKEN=
# your Twilio phone number, e.g. +15551234567
TWILIO_FROM_NUMBER=
# the phone number that receives the alerts
NOTIFY_PHONE=

# ── App ───────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379   # Redis, used only to cache market data; the app still runs if it's down
PORT=8000                          # port the backend API listens on
# HOST=127.0.0.1                   # network address the API listens on. Keep it local: the API has no login and can trade the connected Binance account
# ALLOWED_ORIGINS=                 # extra web origins (comma-separated) allowed to change anything, e.g. http://192.168.1.20:3000
LOG_LEVEL=INFO                     # log detail: DEBUG, INFO, WARNING or ERROR
CLAUDE_MODEL=claude-fable-5-1     # Claude model for every analysis: scanner signals, autotrader checks, Claude swing

# ── Scanner (All Signals tab) ─────────────────────────────────────────────────
# Every 5 minutes the scanner ranks the top coins by how tradeable they are right now and
# scans the best ones; watched coins are re-checked every minute. Scanning is free (no AI).
# Claude is only asked when a scan clears the bars below, so these control the Anthropic bill.
SCANNER_ENABLED=true               # false turns off the scanner, watchlist and autotrader
SCANNER_POOL_SIZE=30               # how many top coins by market cap are considered each sweep
SCANNER_UNIVERSE_SIZE=10           # how many of those (the most tradeable right now) are actually scanned
SCANNER_MIN_CONVICTION=0.45        # signal strength (0–1, either direction) needed before asking Claude
SCANNER_MIN_CONFIDENCE=65          # scan confidence (%) needed before asking Claude
SCANNER_LLM_COOLDOWN=3600          # seconds before Claude is asked about the same coin again
SCANNER_LLM_DAILY_BUDGET=50        # hard cap on the scanner's Claude calls per UTC day
LATE_ENTRY_ATR=2.0                 # skip setups where price is already this many 15m ATRs past its 15m EMA21 — too late to chase (scanner + autotrader)

# ── Autotrader (autonomous experiment: its own wallet; Claude confirms each entry) ──
AUTOTRADER_ENABLED=true            # false stops new autotrader entries (the scanner keeps running)
AUTOTRADER_MIN_CONVICTION=0.20     # signal strength (0–1) needed before a coin is "armed" and watched for an entry
AUTOTRADER_ENTRY_SCORE=65          # 15-minute timing score (0–100) needed to enter an armed coin
AUTOTRADER_RISK_PCT=1.0            # % of the wallet lost if a trade's stop is hit
AUTOTRADER_MAKER_ENTRIES=true      # enter with post-only limits a hair inside the market instead of market orders
# AUTOTRADER_MAKER_OFFSET_BPS=2    # how far inside the last price the maker order rests
# AUTOTRADER_MAKER_TTL=900         # seconds before an unfilled maker entry is cancelled (missed)
# Pullback entries (default since 2026-10-19; they replace the maker entry above, autotrader and signal books):
# a post-only limit this many stop-distances back from the signal price, the stop left where it was
# AUTOTRADER_PULLBACK_ENTRIES=true
# AUTOTRADER_PULLBACK_R=0.25
# AUTOTRADER_PULLBACK_TTL=21600     # seconds before an unfilled pullback entry is cancelled
# Daily minimum (2026-10-25): if nothing was entered for this long, take the strongest setup at reduced risk
# AUTOTRADER_DAILY_MIN=true
# AUTOTRADER_DAILY_MIN_HOURS=24
# AUTOTRADER_DAILY_MIN_RISK_X=0.25
# AUTOTRADER_DAILY_MIN_CONVICTION=0.15
# AUTOTRADER_DAILY_MIN_FLOOR=0.05       # the bar after 6 more idle hours
# Event shorts (2026-10-27): the autotrader mirrors the event book's listing/delisting shorts (coin short + BTC hedge)
# AUTOTRADER_EVENTS=true
# AUTOTRADER_EVENT_LEG_PCT=5              # % of equity a leg (the paper event book uses 10)
# Event book: EVENTS_HOLD_DAYS_LISTING=30, EVENTS_HOLD_DAYS_LAUNCH=30, EVENTS_HOLD_DAYS_DELISTING=7, EVENTS_LEG_PCT=10,
#             EVENTS_MAX_OPEN=10, EVENTS_DISASTER_PCT=25, EVENTS_FUNDING_KILL=0.005
# Carry Q: CARRY_Q_COINS=BTCUSDT,ETHUSDT, CARRY_Q_NOTIONAL_X=3.0, CARRY_Q_ROLL_DAYS=7 · Cascade fade: CASCADE_HOLD_HOURS=4, CASCADE_NOTIONAL_PCT=10
# MAKER_FILL_THROUGH_BPS=2         # paper fills: price must trade this far through a resting maker order
AUTOTRADER_MAX_OPEN_RISK_PCT=4.0   # max % of the wallet at risk across all open trades and pending orders (≈ 4 trades at 1%)
AUTOTRADER_MAX_POSITION_PCT=300    # max size of one position, as % of the wallet (futures notional)
AUTOTRADER_MAX_GROSS_PCT=600       # max size of all positions together, as % of the wallet
AUTOTRADER_COOLDOWN=1800           # seconds before the same coin can be entered again after a trade closes
AUTOTRADER_ALLOW_SHORTS=true       # allow short trades (false = long only; shorts lost in every regime on the 1-year replay)
AUTOTRADER_MAX_BTC_VOL=37          # stand aside when BTC's 30-day volatility (% per year) is above this; 0 = off
AUTOTRADER_FLIP_CONFIRM=900        # seconds a signal must stay flipped against a position before it's closed
AUTOTRADER_LLM_DAILY_BUDGET=50     # max Claude confirmations per UTC day (separate from the scanner's budget)
AUTOTRADER_LLM_BUDGET_WARN=20      # the panel shows Claude usage in red above this many calls
AUTOTRADER_MIN_CLAUDE_CONFIDENCE=65   # Claude must agree with the direction at least this confident (%)
AUTOTRADER_VETO_SECONDS=3600       # after Claude declines a coin, wait this long before asking about it again

# ── Position manager (adds to or trims open trades) ────────────────────────────
POSITION_MANAGER_ENABLED=true      # false stops all size adjustments
POSITION_MANAGER_WALLETS=auto      # which wallets it manages: "auto", or "auto,main" to include your own trades
POSITION_MANAGER_INTERVAL=300      # seconds between reviews of each open trade
POSITION_MANAGER_MIN_GAP=1800      # minimum seconds between two size changes on the same trade
POSITION_MANAGER_AVERAGE_DOWN=true # allow one limited add to a losing trade
POSITION_MANAGER_MAX_RISK_R=1.5    # after averaging down, the most a trade may lose at its stop, in multiples of its original risk

# ── Futures model (both swing wallets: Binance USDⓈ-M perpetuals, isolated margin) ──
# Trades are sized by risk; leverage is only a ceiling. Each trade gets the highest leverage
# up to the max that keeps its liquidation price FUTURES_LIQ_BUFFER × further away than its stop.
FUTURES_MAX_LEVERAGE=20            # highest leverage any swing trade may use (1 = spot)
FUTURES_LIQ_BUFFER=2.0             # liquidation must be at least this many times further away than the stop
FUTURES_MAKER_FEE=0.0002           # fee on resting limit orders (limit entries, take-profits)
FUTURES_TAKER_FEE=0.0005           # fee on market orders (market entries, stops, adds and trims)
FUTURES_SLIPPAGE=0.0003            # price slippage charged against you on every market order
FUTURES_MMR=0.01                   # maintenance margin rate for altcoins (BTC and ETH use 0.4%)
FUTURES_FUNDING=true               # charge/credit the real 8-hourly funding payments (false + leverage 1 = spot)

# ── Exits (both swing wallets) ────────────────────────────────────────────────
EXIT_POLICY=protect                # how new trades exit: protect | trail | trail_stale | partial_trail | fixed | legacy | hold (see trading/exits.py)
EXIT_SHADOW_POLICIES=protect,trail,trail_stale,partial_trail,fixed,legacy,hold   # policies every trade is also simulated under, for the History tab comparison

# ── Market recorder (scalper/recorder.py — 1-second bars and liquidations for the research labs) ──
# Both scalpers that ran on this engine were retired (order-flow 2026-09-29, impulse 2026-10-06) — see the Retired tab.
RECORDER_ENABLED=true              # set to false to stop recording
# SCALPER_SYMBOLS=BTCUSDT,ETHUSDT,… # coins recorded (default: 12 liquid perpetuals)
SCALPER_MARKET_RETENTION_DAYS=30   # days of 1-second bars and liquidations kept (~80 MB/day)

# ── Side experiments (Lab tab — paper only, experiments/) ────────────────────
# Paired tests of what Claude adds (autotrader and scanner signals, each with a rules-only twin)
# and "Claude swing": Claude picking its own 1–7 day trades.
EXPERIMENTS_ENABLED=true           # set to false to stop all side experiments
# EXPERIMENT_RISK_PCT=1.0          # % of equity at the stop for each trade in the signal books
# CLAUDE_SWING_INTERVAL_H=4        # hours between Claude swing reviews
# CLAUDE_SWING_DAILY_CALLS=10      # most Claude calls Claude swing may make per UTC day (its own budget)
# CLAUDE_SWING_MAX_OPEN=3          # most positions or orders Claude swing may hold at once
# Markets tab: stocks & futures (commodity) perps on paper — trend / scanner rules / Claude-confirmed (markets/)
# MARKETS_ENABLED=true
# MARKETS_SWEEP_S=900              # seconds between scans of each market
# MARKETS_TREND_BAND=0.05          # trend books: enter above +5% 6-month return, exit below −5% (stops flapping)
# MARKETS_TREND_VOL_TARGET=0.025    # trend books: daily volatility target per name (1% until 2026-10-27 — positions were ~$200)
# MARKETS_CLAUDE_DAILY_CALLS=20    # Claude approvals a day, per market
# Carry: BTC & ETH cash-and-carry (long spot / short perp, collects funding) — experiments/carry.py
# CARRY_COINS=BTCUSDT,ETHUSDT,XAUUSDT  # gold's spot leg is PAXG (added 2026-10-27)
# CARRY_NOTIONAL_X=3.0             # notional per book as a multiple of its equity (split across the coins; 1.0 until 10-23, 2.0 until 10-28)
# Hold-72: follow |conviction| >= 0.45 for 72 h, each pair hedged with an equal opposite BTC position
# HOLD72_MIN_CONVICTION=0.45
# HOLD72_HOURS=24                  # max hold (72 until 2026-10-23)
# HOLD72_WATCH_BELOW=0.25          # close a pair early once its coin's conviction fades below this
# HOLD72_LEG_PCT=10                # % of the book's equity per leg (15 until 2026-10-19)
# HOLD72_MAX_PAIRS=10
# HOLD72_MAX_PER_SIDE=4            # at most this many pairs facing the same way (one move hits them together)
# HOLD72_DISASTER_PCT=12           # close a pair that is down this much (% of notional)
# CLAUDE_SWING_RISK_PCT=1.0        # % of equity at the stop per Claude swing trade
# CLAUDE_SWING_MODEL=               # model Claude swing reviews with (default: CLAUDE_MODEL)
# CLAUDE_DEBRIEF_DAILY_CALLS=40     # Claude trade debriefs per UTC day (own budget; up to 5 closed trades per call)

# ── Live trading on Binance USDⓈ-M futures (built, OFF by default — see backend/live/) ──
# Nothing is ever sent to Binance unless LIVE_TRADING_ALLOWED=true AND a system is switched
# to live on the Live tab (typed confirmation). Remove the flag to block every live order.
# Before going live: run `./venv/bin/python -m live.selfcheck` with testnet keys.
LIVE_TRADING_ALLOWED=false      # master switch for real orders
BINANCE_ENV=testnet             # testnet (fake funds, testnet.binancefuture.com) or mainnet (REAL MONEY)
LIVE_DAILY_LOSS_PCT=2.0         # per system: stop new live entries after losing this % of the account in a UTC day
# LIVE_MAX_LEVERAGE=20          # highest leverage a live order may use (defaults to FUTURES_MAX_LEVERAGE)
# Futures API keys — enable "Futures" permission only, never withdrawals; restrict to your IP.
# Testnet keys (from testnet.binancefuture.com), shared by all systems:
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# Mainnet keys (only read when BINANCE_ENV=mainnet):
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional per-system keys (a Binance sub-account each keeps positions and balances apart;
# systems sharing one key can't hold the same coin at once). Same pattern for mainnet without TESTNET_:
# BINANCE_TESTNET_MAIN_API_KEY=
# BINANCE_TESTNET_MAIN_API_SECRET=
# BINANCE_TESTNET_AUTO_API_KEY=
# BINANCE_TESTNET_AUTO_API_SECRET=

# ── Research tools (research/*.py) ────────────────────────────────────────────
# CLAUDE_USD_PER_MTOK_IN=5         # Claude input price per million tokens, for the cost-per-call estimate
# CLAUDE_USD_PER_MTOK_OUT=25       # Claude output price per million tokens

# ── Storage locations (SQLite; defaults under backend/data/) ──────────────────
# STATE_DB=data/state.db                    # watchlist, cooldowns, budgets, autotrader state
# SWING_DB=data/swing_trading.db            # both swing wallets: trades, orders, shadows, equity
# SIGNALS_DB=data/signals.db                # Claude analyses, fired signals, watchlist changes, scan features
# SCALPER_TRADES_DB=data/scalper_trades.db  # the retired order-flow scalper's trades (kept as a record)
# SCALPER_MARKET_DB=data/scalper_market.db  # 1-second bars and liquidations (the market recorder)
# LIVE_DB=data/live.db                      # live orders, exchange audit log, live events
# IMPULSE_TRADES_DB=data/impulse_trades.db  # the retired impulse scalper's trades and events (kept as a record)
# RECORDER_DB=data/recorder.db              # the market recorder's feed health and events

# Event calendar (2026-10-28): no new short-term crypto entries around FOMC/CPI; no new stock-trend entries into earnings
# CALENDAR_MACRO_BEFORE_MIN=60
# CALENDAR_MACRO_AFTER_MIN=30
# CALENDAR_EARNINGS_DAYS=2

# $100/day programme (2026-10-28): capital for the evidence books (trading/capital.py); the tracker's daily target
# DAILY_TARGET_USD=100

# Unlock shorts (2026-10-28, experiments/unlocks.py) and the vol-premium condors (experiments/vol_premium.py)
# UNLOCKS_MIN_PCT=1.0
# UNLOCKS_BIG_PCT=5.0
# UNLOCKS_INSIDER_SHARE=0.5
# UNLOCKS_ENTRY_DAYS=14
# UNLOCKS_LEG_PCT=10
# UNLOCKS_MAX_OPEN=8
# VOL_PREMIUM_COINS=BTC,ETH
# VOL_PREMIUM_RISK_PCT=5

# Copy trading (2026-10-28, experiments/copy_trading.py): Binance lead traders mirrored on paper
# COPY_LEADERS_N=5          # per venue (Binance copy board, Hyperliquid)
# COPY_CONSENSUS_X=1.5      # size multiplier when ≥2 leaders hold the same side
# COPY_POLL_S=90
# COPY_LEG_PCT=5
# COPY_MAX_LEVERAGE=5
# COPY_MAX_OPEN=12
# COPY_DISASTER_PCT=8

# Trend books (2026-10-28): take profit on positions older than a week up this much on the full position size (price move)
# MARKETS_TREND_TAKE_PROFIT_PCT=25
# MARKETS_TREND_TAKE_PROFIT_DAYS=7
# MARKETS_TREND_TAKE_PROFIT_BASIS=price # price = % of position size (default); roe = return on margin

# Dry-market widening (2026-10-28): after this many idle hours the autotrader scans this many coins (normally 10)
# AUTOTRADER_DRY_HOURS=12
# AUTOTRADER_DRY_UNIVERSE=30
